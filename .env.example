# AI providers
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local AI (default)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=90

# Web search: auto selects Brave, then Serper, then the no-key public fallback.
WEB_SEARCH_PROVIDER=auto
BRAVE_API_KEY=
SERPER_API_KEY=
WEB_REQUEST_TIMEOUT_SECONDS=10

# Movie/TV metadata, posters, ratings, seasons/episodes and India watch-provider data.
TMDB_API_KEY=

DATABASE_URL=sqlite:///./data/manu_ai.db
ALLOWED_ORIGINS=http://localhost:3000
