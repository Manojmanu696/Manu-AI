# Optional. Without this key Manu AI uses private, local demo responses.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local AI (default). The model is auto-detected when this is blank.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=90

# Internet research is opt-in at the feature level; it never uploads your library.
WEB_SEARCH_PROVIDER=duckduckgo_html
WEB_REQUEST_TIMEOUT_SECONDS=10
# Optional factual catalogue provider. No API key is required for local recommendations.
TMDB_API_KEY=

# The default stores the database alongside the project for easy backups.
DATABASE_URL=sqlite:///./data/manu_ai.db
ALLOWED_ORIGINS=http://localhost:3000
